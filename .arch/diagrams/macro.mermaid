flowchart LR
    node_web_app(["Web App<br/><small>React 19 / Vite</small>"])
    node_api_gateway{{"API Gateway<br/><small>Traefik</small>"}}
    node_core_api["Core API<br/><small>Go 1.23 / net/http</small>"]
    node_postgres[("PostgreSQL<br/><small>PostgreSQL 16</small>")]
    node_redis(("Redis<br/><small>Redis 7</small>"))
    node_api_gateway -->|"REST :8080"| node_core_api
    node_core_api -->|"SQL :5432"| node_postgres
    node_core_api -->|"Redis :6379"| node_redis
    node_web_app -->|"REST :443"| node_api_gateway

