# ==============================================================================
# ArchCode Studio - Variáveis de Ambiente (.env.example)
# Copie para .env e ajuste conforme seu ambiente
# ==============================================================================

# Porta de ligação no host
PORT_BIND=8765

# Diretório no host onde o projeto (.arch/, docs/, api/) é persistido
WORKSPACE_DIR_HOST=./workspace

# Nome do projeto criado automaticamente no primeiro boot
ARCHCODE_PROJECT_NAME=ArchCode Project

# URL pública do deploy (necessária para o MCP via SSE atrás de proxy)
ARCHCODE_BASE_URL=
